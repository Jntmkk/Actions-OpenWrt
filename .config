# OpenWrt 配置 for Newifi D2 (MT7621) - 32MB 闪存布局
# 编译 xray + passwall，去掉老插件

# 目标平台
CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7621=y
CONFIG_TARGET_ramips_mt7621_DEVICE_newifi-d2=y

# 基本系统
CONFIG_PACKAGE_dnsmasq_full=y
# CONFIG_PACKAGE_dnsmasq is not set

# LuCI 界面
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-opkg=y
CONFIG_PACKAGE_luci-theme-bootstrap=y

# 网络工具
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget=y
CONFIG_PACKAGE_htop=y

# 代理插件 - xray + passwall（核心）
CONFIG_PACKAGE_xray-core=y
CONFIG_PACKAGE_luci-app-passwall=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Xray=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_V2ray_Plugin=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadowsocks=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_ShadowsocksR=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Trojan=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Simple_Obfs=n

# 不要老插件（v2ray, ssr 等）
# CONFIG_PACKAGE_v2ray-core is not set
# CONFIG_PACKAGE_v2ray-plugin is not set
# CONFIG_PACKAGE_shadowsocks-libev-ss-local is not set
# CONFIG_PACKAGE_shadowsocks-libev-ss-redir is not set
# CONFIG_PACKAGE_shadowsocksr-libev-alt is not set
# CONFIG_PACKAGE_trojan is not set

# 常用工具
CONFIG_PACKAGE_iptables-nft=y
CONFIG_PACKAGE_kmod-ipt-nat=y
CONFIG_PACKAGE_kmod-nf-nat=y

# WiFi 驱动（新路由3: MT7603E 2.4G + MT7612E 5G）
CONFIG_PACKAGE_kmod-mt7603=y
CONFIG_PACKAGE_kmod-mt7612e=y

# 有线网络驱动（MT7530 交换机）
CONFIG_PACKAGE_kmod-mt7530=y

# 压缩固件
CONFIG_TARGET_IMAGES_GZIP=y

# 32MB 闪存布局支持（breed）
CONFIG_TARGET_ROOTFS_SQUASHFS=y
