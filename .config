# 最小配置 - 让 make defconfig 自动补全默认值
# 只指定关键项，避免手动配置错误

# 目标平台（Newifi D2）
CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7621=y
CONFIG_TARGET_ramips_mt7621_DEVICE_d-team_newifi-d2=y

# 使用稳定的 Linux 6.6 内核（避免 6.18 的兼容性问题）
CONFIG_LINUX_6_6=y
# CONFIG_LINUX_6_18 is not set

# 禁用 HNAT（硬件 NAT），避免 mt7621-vendor 驱动编译错误
# MT7621 的 HNAT 驱动与 Linux 6.18 不兼容，禁用后使用软件 NAT
CONFIG_PACKAGE_kmod-mt7621-hnat=n
CONFIG_PACKAGE_kmod-hnat=n

# LuCI Web 界面
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-opkg=y

# 代理插件 - xray + passwall
CONFIG_PACKAGE_xray-core=y
CONFIG_PACKAGE_luci-app-passwall=y

# 网络工具
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget=y
CONFIG_PACKAGE_htop=y

# 压缩固件
CONFIG_TARGET_IMAGES_GZIP=y
